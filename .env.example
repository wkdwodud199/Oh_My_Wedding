# 기본 상태는 로컬 가상 예제입니다. 실제 전송/시트 변경은 하지 않습니다.
WEDDING_MODE=demo
TIMEZONE=Asia/Seoul
# live 전환 시 data/live-state.sqlite3로 바꾸세요. 서로 다른 모드의 기록은 섞을 수 없습니다.
STATE_PATH=data/demo-state.sqlite3
LOCAL_TASKS_PATH=data/tasks.json

# live 전환 시 본인의 시트 ID 및 Google 서비스 계정 JSON 경로를 입력합니다.
# JSON 파일 내용이나 봇 토큰을 채팅/저장소에 올리지 마세요.
SPREADSHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=
SHEETS_WRITE_ENABLED=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TAVILY_API_KEY=

# ChatGPT AI는 codex login으로 로그인한 OAuth 계정만 사용합니다. OpenAI API 키 없음.
# none은 AI 요약을 명시적으로 끄고 검색 발췌만 제공하는 모드입니다.
AI_BACKEND=codex_oauth
CODEX_COMMAND=codex
CODEX_MODEL=
CODEX_TIMEOUT_SECONDS=180

# 서울 시간 매일 20~21시 사이 마감 알림/조사 작업. 명령 응답은 항상 가능.
DIGEST_HOUR=20
QUIET_END_HOUR=21
RESEARCH_INTERVAL_DAYS=7
MAX_RESEARCH_PER_RUN=3
